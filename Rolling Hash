const ll mod1 = 1e9 + 7;
const ll mod2 = 1e9 + 9;
const ll base = 31;

pair<ll, ll> compute_hash(string s) {
    ll h1 = 0, h2 = 0;
    ll p1 = 1, p2 = 1;

    for(char c : s) {
        int val = c - 'a' + 1;

        h1 = (h1 + val * p1) % mod1;
        h2 = (h2 + val * p2) % mod2;

        p1 = (p1 * base) % mod1;
        p2 = (p2 * base) % mod2;
    }

    return {h1, h2};
}


Unordered map with custom pair of hash

typedef long long ll;

struct pair_hash {
    size_t operator()(const pair<ll,ll>& p) const {
        return p.first * 31 + p.second;
    }
};

unordered_map<pair<ll,ll>, int, pair_hash> mp;

